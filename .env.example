# ── Kaggle token (required for data download) ─────────────────────────────
# New-style token from https://www.kaggle.com/settings → API → "Create New Token"
KAGGLE_API_TOKEN=KGAT_your_token_here

# ── LLM API key (required for phases 3-7: classify, draft, judge) ─────────
# Provide one of these. agent/agent.py auto-detects whichever is set.
OPENAI_API_KEY=sk-...your-openai-key...
# GEMINI_API_KEY=your-gemini-key-here

# ── Brand (set after Step 0 sign-off) ────────────────────────────────────
BRAND_NAME=AmazonHelp

# ── Subsample sizes ───────────────────────────────────────────────────────
PROFILE_SAMPLE_N=500000
CORPUS_SAMPLE_N=50000

# ── HuggingFace offline mode ──────────────────────────────────────────────
# After first run, the MiniLM model is cached locally.
# Set these to skip SSL HEAD requests to huggingface.co (eliminates ~3min of retry noise).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
